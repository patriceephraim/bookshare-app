{
  "expo": {
    "name": "Bookshare",
    "slug": "Bookshare",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bookshare",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/auth-image.png",
          "resizeMode": "cover",
          "backgroundColor": "#6B5239"
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      "expo-camera",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Bookshare uses your location to show books near you."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Bookshare uses your photos to identify book covers."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
